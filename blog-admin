<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>UltraByte Admin ⚡</title>
  <style>
    body { font-family: sans-serif; background: #0f172a; color: #f8fafc; padding: 20px; }
    .card { background: #1e293b; padding: 20px; border-radius: 8px; max-width: 600px; margin: 0 auto 20px; }
    input, textarea, button { width: 100%; padding: 10px; margin-top: 8px; border-radius: 4px; border: 1px solid #334155; background: #0f172a; color: #fff; box-sizing: border-box; }
    button { background: #2563eb; font-weight: bold; cursor: pointer; border: none; margin-top: 15px; }
    button:hover { background: #1d4ed8; }
    .hidden { display: none; }
  </style>
</head>
<body>

  <!-- TELA DE LOGIN -->
  <div id="login-screen" class="card">
    <h2>Painel UltraByte - Auth ⚡</h2>
    <input type="password" id="admin-pass" placeholder="Digite a Senha Administrativa">
    <button onclick="login()">Entrar</button>
    <p id="login-msg" style="color: #ef4444;"></p>
  </div>

  <!-- PAINEL DE CRIAÇÃO -->
  <div id="admin-panel" class="card hidden">
    <h2>Novo Artigo</h2>
    <input type="text" id="post-title" placeholder="Título do Artigo">
    <input type="text" id="post-category" placeholder="Categoria (ex: Tec, Dev)">
    <input type="text" id="post-summary" placeholder="Resumo curto">
    <textarea id="post-content" rows="8" placeholder="Conteúdo (HTML ou texto)"></textarea>
    <button onclick="publishArticle()">Publicar no GitHub 🚀</button>
    <p id="status-msg"></p>
  </div>

  <script>
    // Substitua pela URL do seu Cloudflare Worker após criá-lo
    const WORKER_URL = "https://ultrabyte-worker.SUO_SUBDOMINIO.workers.dev"; 

    function login() {
      const pass = document.getElementById('admin-pass').value;
      if (pass) {
        // Armazena temporariamente na sessão do navegador
        sessionStorage.setItem('admin_pass', pass);
        document.getElementById('login-screen').classList.add('hidden');
        document.getElementById('admin-panel').classList.remove('hidden');
      } else {
        document.getElementById('login-msg').innerText = "Por favor, digite a senha.";
      }
    }

    async function publishArticle() {
      const pass = sessionStorage.getItem('admin_pass');
      const title = document.getElementById('post-title').value;
      const category = document.getElementById('post-category').value;
      const summary = document.getElementById('post-summary').value;
      const content = document.getElementById('post-content').value;
      const statusMsg = document.getElementById('status-msg');

      if (!title || !content) {
        statusMsg.innerText = "Título e conteúdo são obrigatórios!";
        return;
      }

      statusMsg.innerText = "Publicando...";

      try {
        const response = await fetch(WORKER_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ pass, title, category, summary, content })
        });

        const result = await response.json();

        if (response.ok) {
          statusMsg.style.color = "#22c55e";
          statusMsg.innerText = "Artigo publicado com sucesso! O GitHub Pages atualizará em instantes.";
        } else {
          statusMsg.style.color = "#ef4444";
          statusMsg.innerText = "Erro: " + (result.error || "Falha na publicação.");
        }
      } catch (err) {
        statusMsg.style.color = "#ef4444";
        statusMsg.innerText = "Erro ao conectar com o Worker.";
      }
    }
  </script>
</body>
</html>
